# ── Food Reviews — Podman Environment ────────────────────────────────────────
# Copy to .env for local `php artisan` commands, or use directly via compose.
# Podman Compose sources this file automatically.

APP_NAME="Food Reviews"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=http://localhost:8004

# ── Database ──────────────────────────────────────────────────────────────────
DB_CONNECTION=mysql
DB_HOST=db
DB_PORT=3306
DB_DATABASE=food_reviews
DB_USERNAME=food_reviews
DB_PASSWORD=asdfasdfasdfasdfasdf
DB_ROOT_PASSWORD=rootpassword

# ── Redis (Session, Cache, Queue) ────────────────────────────────────────────
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=null
REDIS_CLIENT=predis

SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false

CACHE_STORE=redis
CACHE_PREFIX=food_reviews_

QUEUE_CONNECTION=redis

# ── Broadcast ────────────────────────────────────────────────────────────────
BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local

# ── Mail ─────────────────────────────────────────────────────────────────────
MAIL_MAILER=smtp
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your-email@gmail.com
MAIL_PASSWORD=your-app-password
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS="your-email@gmail.com"
MAIL_FROM_NAME="Food Reviews"

# ── Logging ──────────────────────────────────────────────────────────────────
LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=warning
