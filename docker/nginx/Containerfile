# =============================================================================
# Containerfile — Nginx for Food Reviews
# Self-contained multi-stage: builds frontend assets, serves them statically.
# PHP requests are proxied to the app container (PHP-FPM).
# =============================================================================

# ── Stage 1: Build frontend assets ──────────────────────────────────────────
FROM node:22-alpine AS builder

WORKDIR /build

# Cache NPM deps
COPY package.json package-lock.json ./
RUN npm ci --no-audit --no-fund

COPY resources/ resources/
COPY vite.config.js ./
COPY tailwind.config.js ./

RUN npm run build

# ── Stage 2: Nginx ─────────────────────────────────────────────────────────
FROM docker.io/nginx:stable-alpine

# Copy public assets from host (images, favicon, etc.)
COPY public/ /var/www/html/public/

# Overwrite with freshly compiled build assets
COPY --from=builder /build/public/build /var/www/html/public/build

# Remove any broken storage symlink — uploads come via a named volume at runtime
RUN rm -f /var/www/html/public/storage

# Nginx configuration
COPY docker/nginx/default.conf /etc/nginx/conf.d/default.conf

EXPOSE 80
CMD ["nginx", "-g", "daemon off;"]
